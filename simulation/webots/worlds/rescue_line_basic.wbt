#VRML_SIM R2025a utf8
# Mondo placeholder M1 (SPEC §6.3): pavimento bianco, linea nera 19mm
# (rettilineo 2m + curva 90° a destra + marker verde), robot differenziale.
# Solo nodi built-in + forme locali: zero download remoti.

WorldInfo {
  title "Rescue Line basic (placeholder M1)"
  basicTimeStep 32
  coordinateSystem "NUE"
}
Viewpoint {
  orientation 0 1 0 3.14159
  position 0 1.6 -2.8
}
Background {
  skyColor [
    0.55 0.6 0.65
  ]
}
DEF FLOOR Solid {
  translation 0 0 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.93 0.93 0.93
        roughness 1
        metalness 0
      }
      geometry Box {
        size 3 0.02 3
      }
    }
  ]
  name "floor"
  boundingObject Box {
    size 3 0.02 3
  }
}
# Rettilineo: linea nera lungo Z, da z=-1 a z=+1
DEF LINE_STRAIGHT Transform {
  translation 0 0.011 0
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.02 0.02 0.02
        roughness 1
        metalness 0
      }
      geometry Box {
        size 0.019 0.002 2
      }
    }
  ]
}
# Curva 90° a destra (marcia verso +Z, destra = -X): da x=0 a x=-1 a z=+1
DEF LINE_TURN Transform {
  translation -0.5 0.011 1
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.02 0.02 0.02
        roughness 1
        metalness 0
      }
      geometry Box {
        size 1 0.002 0.019
      }
    }
  ]
}
# Marker verde a destra prima della curva (M2, solo riferimento visivo)
DEF MARKER_GREEN Transform {
  translation -0.06 0.011 0.9
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.05 0.7 0.15
        roughness 1
        metalness 0
      }
      geometry Box {
        size 0.05 0.002 0.05
      }
    }
  ]
}
DEF RESCUEBOT Robot {
  translation 0 0 -1.3
  children [
    Solid {
      translation 0 0.08 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.2 0.35 0.8
            roughness 0.6
            metalness 0
          }
          geometry Box {
            size 0.16 0.07 0.22
          }
        }
      ]
      name "body"
      boundingObject Box {
        size 0.16 0.07 0.22
      }
      physics Physics {
        density 800
      }
    }
    # Camera verde: inclinata ~45° verso il basso (SPEC §2.1)
    Camera {
      translation 0 0.15 0.09
      rotation 1 0 0 -0.785
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.1 0.6 0.1
            roughness 0.6
            metalness 0
          }
          geometry Box {
            size 0.03 0.03 0.03
          }
        }
      ]
      name "camera_green"
      width 640
      height 480
      near 0.01
    }
    # Camera nera: orizzontale in avanti (stanza/vittime M2)
    Camera {
      translation 0 0.15 0.11
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.05 0.05 0.05
            roughness 0.6
            metalness 0
          }
          geometry Box {
            size 0.03 0.03 0.03
          }
        }
      ]
      name "camera_black"
      width 640
      height 480
      near 0.01
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor -0.095 0.04 0
      }
      device [
        RotationalMotor {
          name "motor_left"
          maxVelocity 10
        }
      ]
      endPoint Solid {
        translation -0.095 0.04 0
        rotation 0 0 1 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.08 0.08 0.08
              roughness 0.9
              metalness 0
            }
            geometry Cylinder {
              radius 0.03
              height 0.025
            }
          }
        ]
        name "wheel_left"
        boundingObject Cylinder {
          radius 0.03
          height 0.025
        }
        physics Physics {
          density 900
        }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor 0.095 0.04 0
      }
      device [
        RotationalMotor {
          name "motor_right"
          maxVelocity 10
        }
      ]
      endPoint Solid {
        translation 0.095 0.04 0
        rotation 0 0 1 1.5708
        children [
          Shape {
            appearance PBRAppearance {
              baseColor 0.08 0.08 0.08
              roughness 0.9
              metalness 0
            }
            geometry Cylinder {
              radius 0.03
              height 0.025
            }
          }
        ]
        name "wheel_right"
        boundingObject Cylinder {
          radius 0.03
          height 0.025
        }
        physics Physics {
          density 900
        }
      }
    }
  ]
  name "rescuebot"
  controller "rescue_controller"
  # NOTA: warning "Mass is invalid because 'boundingObject' is not defined"
  # atteso e innocuo (massa default=1): il bounding sul Robot intero
  # impedirebbe alle ruote di toccare il suolo, quindi resta sui singoli Solid.
  physics Physics {
  }
}
